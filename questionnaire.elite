<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Formation CMP — Questionnaire de qualification</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream: #f5f0e8;
    --cream2: #ede7d9;
    --cream3: #e6ddd0;
    --navy: #1a2744;
    --navy2: #243158;
    --blue: #2d4a8a;
    --blue-light: #4a6db0;
    --text: #1a2744;
    --text2: #4a5568;
    --text3: #7a8599;
    --border: rgba(26,39,68,0.12);
    --border2: rgba(26,39,68,0.22);
    --shadow: 0 2px 16px rgba(26,39,68,0.08);
    --radius: 12px;
    --transition: 0.18s ease;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--cream);
    color: var(--text);
    font-family: 'Lato', sans-serif;
    font-weight: 300;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2.5rem 1rem 5rem;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 40% at 50% 0%, rgba(45,74,138,0.06) 0%, transparent 70%),
      radial-gradient(ellipse 50% 50% at 100% 100%, rgba(45,74,138,0.04) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  .container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 620px;
  }

  /* Header */
  .header {
    text-align: center;
    margin-bottom: 2.5rem;
    opacity: 0;
    animation: fadeUp 0.7s ease forwards;
  }

  .logo-wrap {
    margin-bottom: 1.25rem;
  }

  .logo-wrap img {
    height: 72px;
    width: auto;
    object-fit: contain;

  }

  .header-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0.75rem auto 1rem;
    max-width: 280px;
  }

  .header-divider::before,
  .header-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--navy);
    opacity: 0.2;
  }

  .header-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .header h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.75rem, 4.5vw, 2.4rem);
    font-weight: 400;
    color: var(--navy);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .header h1 em {
    font-style: italic;
    color: var(--blue);
  }

  .header-sub {
    font-size: 14px;
    color: var(--text2);
    line-height: 1.7;
    max-width: 400px;
    margin: 0 auto;
  }

  /* Progress */
  .progress-wrap {
    margin-bottom: 2rem;
    opacity: 0;
    animation: fadeUp 0.7s ease 0.1s forwards;
  }

  .progress-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .progress-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text3);
  }

  .progress-step {
    font-size: 12px;
    font-weight: 700;
    color: var(--blue);
  }

  .progress-track {
    height: 3px;
    background: var(--cream3);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--navy), var(--blue-light));
    border-radius: 999px;
    transition: width 0.5s cubic-bezier(0.4,0,0.2,1);
  }

  /* Section badge */
  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: white;
    border: 1px solid var(--border2);
    border-radius: 999px;
    padding: 5px 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow);
  }

  /* Cards */
  .q-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 1rem;
    box-shadow: var(--shadow);
    animation: fadeUp 0.45s ease forwards;
    opacity: 0;
  }

  .q-card:nth-child(2) { animation-delay: 0.05s; }
  .q-card:nth-child(3) { animation-delay: 0.1s; }
  .q-card:nth-child(4) { animation-delay: 0.15s; }
  .q-card:nth-child(5) { animation-delay: 0.2s; }
  .q-card:nth-child(6) { animation-delay: 0.25s; }

  .q-label {
    font-size: 15px;
    font-weight: 400;
    color: var(--text);
    margin-bottom: 1rem;
    line-height: 1.55;
  }

  .q-sub {
    font-size: 13px;
    color: var(--text3);
    margin-bottom: 1rem;
    margin-top: -0.5rem;
    font-style: italic;
  }

  /* Options */
  .option-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    text-align: left;
    background: var(--cream);
    border: 1.5px solid transparent;
    border-radius: 9px;
    padding: 11px 14px;
    margin-bottom: 8px;
    cursor: pointer;
    font-size: 14px;
    font-family: 'Lato', sans-serif;
    font-weight: 300;
    color: var(--text2);
    transition: all var(--transition);
  }

  .option-btn:last-child { margin-bottom: 0; }

  .option-btn:hover {
    border-color: var(--blue-light);
    background: #edf2fc;
    color: var(--text);
  }

  .option-btn.selected {
    border-color: var(--navy);
    background: #e8eef7;
    color: var(--navy);
  }

  .option-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid var(--border2);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition);
    background: white;
  }

  .option-btn.selected .option-dot {
    background: var(--navy);
    border-color: var(--navy);
  }

  .option-dot-inner {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: white;
    display: none;
  }

  .option-btn.selected .option-dot-inner { display: block; }

  /* Inputs */
  .input-group { display: grid; gap: 14px; }

  .input-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text3);
    margin-bottom: 6px;
  }

  .q-input, .q-textarea {
    width: 100%;
    background: var(--cream);
    border: 1px solid var(--border2);
    border-radius: 9px;
    padding: 11px 14px;
    font-size: 14px;
    font-family: 'Lato', sans-serif;
    font-weight: 300;
    color: var(--text);
    transition: border-color var(--transition), box-shadow var(--transition);
    outline: none;
  }

  .q-input::placeholder, .q-textarea::placeholder { color: var(--text3); }

  .q-input:focus, .q-textarea:focus {
    border-color: var(--blue);
    background: white;
    box-shadow: 0 0 0 3px rgba(45,74,138,0.1);
  }

  .q-textarea {
    resize: vertical;
    min-height: 90px;
    line-height: 1.6;
  }

  /* Navigation */
  .nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.75rem;
    gap: 12px;
  }

  .btn-next {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--navy);
    color: white;
    border: none;
    border-radius: 9px;
    padding: 12px 28px;
    font-size: 13px;
    font-family: 'Lato', sans-serif;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all var(--transition);
    box-shadow: 0 2px 10px rgba(26,39,68,0.2);
  }

  .btn-next:hover {
    background: var(--navy2);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(26,39,68,0.25);
  }

  .btn-next:active { transform: translateY(0); }

  .btn-next:disabled {
    background: var(--cream3);
    color: var(--text3);
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
    border: 1px solid var(--border);
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    color: var(--text3);
    border: 1px solid var(--border2);
    border-radius: 9px;
    padding: 12px 20px;
    font-size: 13px;
    font-family: 'Lato', sans-serif;
    font-weight: 400;
    cursor: pointer;
    transition: all var(--transition);
  }

  .btn-back:hover { color: var(--text); border-color: var(--blue); background: white; }

  .step-info {
    font-size: 12px;
    color: var(--text3);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  /* Result */
  .result-card {
    background: white;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 3rem 2rem;
    text-align: center;
    box-shadow: var(--shadow);
    animation: fadeUp 0.6s ease forwards;
  }

  .result-icon {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #e8eef7;
    border: 1px solid var(--border2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    font-size: 28px;
    color: var(--navy);
  }

  .result-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 400;
    color: var(--navy);
    margin-bottom: 0.75rem;
  }

  .result-sub {
    font-size: 14px;
    color: var(--text2);
    line-height: 1.75;
    max-width: 380px;
    margin: 0 auto 1.5rem;
  }

  .result-notice {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #e8eef7;
    border: 1px solid var(--border2);
    border-radius: 9px;
    padding: 10px 18px;
    font-size: 13px;
    color: var(--navy);
    font-weight: 400;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes spin { to { transform: rotate(360deg); } }
  .spin { display: inline-block; animation: spin 0.9s linear infinite; }

  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: var(--cream); }
  ::-webkit-scrollbar-thumb { background: var(--cream3); border-radius: 999px; }

  @media (max-width: 480px) {
    body { padding: 1.5rem 0.75rem 3rem; }
    .btn-next { padding: 11px 18px; }
    .btn-back { padding: 11px 14px; }
  }
</style>
</head>
<body>
<div class="container">

  <div class="header">
    <div class="logo-wrap">
      <img src="data:image/png;base64," alt="Groupe C.M.P" />
    </div>
    <div class="header-divider">
      <span class="header-eyebrow">Formation CMP</span>
    </div>
    <h1>Candidature<br><em>Programme Élite</em></h1>
    <p class="header-sub">Répondez honnêtement à chaque question. Ce questionnaire nous permet de nous assurer que le programme correspond à votre profil.</p>
  </div>

  <div class="progress-wrap">
    <div class="progress-meta">
      <span class="progress-label">Progression</span>
      <span class="progress-step" id="stepLabel">1 / 4</span>
    </div>
    <div class="progress-track">
      <div class="progress-fill" id="progressFill" style="width:0%"></div>
    </div>
  </div>

  <div id="quiz-root"></div>
</div>

<script>
const EMAILJS_SERVICE_ID  = 'service_0c6z39f';
const EMAILJS_TEMPLATE_ID = 'template_rygou0c';
const EMAILJS_PUBLIC_KEY  = 'tMbXhuTLW7tHBTClo';

const sections = [
  {
    id: "contact", badge: "Vos coordonnées",
    questions: [
      { id: "name",  type: "text",  label: "Prénom et nom",       placeholder: "Ex : Marie Tremblay",   required: true },
      { id: "phone", type: "tel",   label: "Numéro de téléphone", placeholder: "Ex : 418 555-0123",      required: true },
      { id: "email", type: "email", label: "Adresse courriel",    placeholder: "votre@courriel.com",     required: true },
    ]
  },
  {
    id: "tech", badge: "Section 1 — Aisance technologique",
    questions: [
      { id: "tech1", type: "single",
        label: "Comment décririez-vous votre niveau général avec les outils informatiques et internet ?",
        options: [
          { val: 0, text: "Débutant — j'ai de la difficulté avec les tâches simples" },
          { val: 1, text: "Intermédiaire — à l'aise pour la navigation, les courriels et les logiciels courants" },
          { val: 2, text: "Avancé — j'utilise régulièrement plusieurs outils numériques sans problème" },
        ], disq: [0] },
      { id: "tech2", type: "single",
        label: "Avez-vous déjà utilisé une plateforme de courtage en ligne (ex : Questrade, Interactive Brokers, TD Direct…) ?",
        options: [
          { val: 0, text: "Non, jamais" },
          { val: 1, text: "J'en ai entendu parler mais je n'en ai pas encore utilisé" },
          { val: 2, text: "Oui, j'ai déjà passé des ordres d'achat ou de vente" },
          { val: 3, text: "Oui, je l'utilise régulièrement" },
        ] },
      { id: "tech3", type: "single",
        label: "Êtes-vous à l'aise avec les outils de vidéoconférence (Zoom, Google Meet, etc.) pour vos sessions 1-on-1 ?",
        options: [
          { val: 0, text: "Non, je n'ai jamais utilisé ce type d'outil" },
          { val: 1, text: "Je peux l'utiliser avec un peu d'aide" },
          { val: 2, text: "Oui, je suis totalement à l'aise" },
        ], disq: [0] },
      { id: "tech4", type: "single",
        label: "Avez-vous accès à un ordinateur (fixe ou portable) avec une connexion internet stable pour suivre les marchés et les sessions en direct ?",
        options: [
          { val: 0, text: "Non" },
          { val: 1, text: "J'utilise principalement un téléphone ou une tablette" },
          { val: 2, text: "Oui, j'ai un ordinateur et une bonne connexion" },
        ], disq: [0] },
    ]
  },
  {
    id: "market", badge: "Section 2 — Connaissances des marchés",
    questions: [
      { id: "mkt1", type: "single",
        label: "Quelle est votre expérience avec les marchés financiers en général ?",
        options: [
          { val: 0, text: "Aucune — je commence à zéro" },
          { val: 1, text: "Notions de base — je sais ce qu'est une action, un titre boursier" },
          { val: 2, text: "Intermédiaire — j'ai fait des recherches sérieuses ou suivi des cours" },
          { val: 3, text: "Expérimenté — j'ai des placements actifs ou passés" },
        ], disq: [0] },
      { id: "mkt2", type: "single",
        label: "Que signifie vendre à découvert (short selling) selon vous ?",
        options: [
          { val: 0, text: "Je ne sais pas" },
          { val: 1, text: "Vendre des actions que l'on possède pour encaisser un gain rapide" },
          { val: 2, text: "Emprunter un titre pour le vendre, dans l'espoir de le racheter moins cher plus tard" },
          { val: 3, text: "Parier sur la baisse d'un titre en utilisant des produits dérivés" },
        ] },
      { id: "mkt3", type: "single",
        label: "Avez-vous déjà analysé un graphique boursier (chandeliers japonais, supports/résistances, indicateurs…) ?",
        options: [
          { val: 0, text: "Non, jamais" },
          { val: 1, text: "J'ai regardé des graphiques mais sans vraiment comprendre" },
          { val: 2, text: "Oui, je connais les bases de l'analyse technique" },
          { val: 3, text: "Oui, j'applique régulièrement l'analyse technique" },
        ] },
      { id: "mkt4", type: "single",
        label: "Comment définissez-vous votre tolérance au risque ?",
        options: [
          { val: 0, text: "Très faible — je ne peux pas me permettre de pertes" },
          { val: 1, text: "Modérée — j'accepte quelques pertes si l'espérance de gain est là" },
          { val: 2, text: "Élevée — je comprends que le trading actif comporte des risques importants et je suis prêt(e) à y faire face" },
        ], disq: [0] },
    ]
  },
  {
    id: "commitment", badge: "Section 3 — Engagement & motivation",
    questions: [
      { id: "com1", type: "single",
        label: "Combien d'heures par semaine pouvez-vous consacrer à l'apprentissage du trading (formation + pratique) ?",
        options: [
          { val: 0, text: "Moins de 5 heures" },
          { val: 1, text: "Entre 5 et 10 heures" },
          { val: 2, text: "Plus de 10 heures" },
        ], disq: [0] },
      { id: "com2", type: "single",
        label: "Disposez-vous d'un capital de départ que vous êtes prêt(e) à allouer au trading (en dehors du coût de la formation) ?",
        options: [
          { val: 0, text: "Non, pas encore" },
          { val: 1, text: "Oui, moins de 5 000 $" },
          { val: 2, text: "Oui, entre 5 000 $ et 20 000 $" },
          { val: 3, text: "Oui, plus de 20 000 $" },
        ] },
      { id: "com3", type: "single",
        label: "Quel est votre objectif principal en rejoignant le programme Élite ?",
        options: [
          { val: 1, text: "Générer un revenu complémentaire avec le trading" },
          { val: 2, text: "Devenir trader à temps plein" },
          { val: 2, text: "Apprendre à gérer mes propres placements de façon autonome" },
          { val: 1, text: "Je suis simplement curieux(se) — je ne suis pas encore sûr(e)" },
        ] },
      { id: "com4", type: "open",
        label: "En quelques lignes, pourquoi souhaitez-vous rejoindre l'accompagnement Élite maintenant ?",
        sub: "Cette réponse sera lue personnellement avant votre appel de sélection.",
        placeholder: "Partagez votre situation, vos objectifs et pourquoi ce moment est le bon pour vous…" },
    ]
  }
];

let currentSection = 0;
let answers = {};
let sending = false;

const labelMap = {
  name:"Nom complet", phone:"Téléphone", email:"Courriel",
  tech1:"Niveau informatique", tech2:"Expérience courtage",
  tech3:"Vidéoconférence", tech4:"Équipement",
  mkt1:"Expérience marchés", mkt2:"Définition short selling",
  mkt3:"Analyse technique", mkt4:"Tolérance au risque",
  com1:"Disponibilité hebdomadaire", com2:"Capital disponible",
  com3:"Objectif principal", com4:"Motivation personnelle"
};

function buildEmailBody() {
  let lines = ["=== NOUVELLE CANDIDATURE — FORMATION CMP — PROGRAMME ÉLITE ===\n"];
  lines.push("COORDONNÉES");
  lines.push("Nom : " + (answers['name']||'—'));
  lines.push("Téléphone : " + (answers['phone']||'—'));
  lines.push("Courriel : " + (answers['email']||'—'));
  lines.push("");
  sections.slice(1).forEach(sec => {
    lines.push(sec.badge.toUpperCase());
    sec.questions.forEach(q => {
      const label = labelMap[q.id]||q.id;
      if (q.type==='single') {
        const idx = answers[q.id];
        lines.push(label+" : "+(idx!==undefined?q.options[idx].text:'—'));
      } else if (q.type==='open') {
        lines.push(label+" :\n"+(answers[q.id]||'—'));
      }
    });
    lines.push("");
  });
  return lines.join("\n");
}

function updateProgress() {
  const pct = Math.round((currentSection/sections.length)*100);
  document.getElementById('progressFill').style.width = pct+'%';
  document.getElementById('stepLabel').textContent = (currentSection+1)+' / '+sections.length;
}

function render() {
  const root = document.getElementById('quiz-root');
  updateProgress();
  if (currentSection >= sections.length) { renderResult(root); return; }
  const sec = sections[currentSection];
  let html = `<div class="section-badge">${sec.badge}</div>`;

  if (sec.id==='contact') {
    html += `<div class="q-card"><div class="input-group">`;
    sec.questions.forEach(q => {
      const val = answers[q.id]||'';
      html += `<div>
        <label class="input-label" for="field_${q.id}">${q.label}</label>
        <input class="q-input" id="field_${q.id}" type="${q.type}" placeholder="${q.placeholder}" value="${val.replace(/"/g,'&quot;')}" oninput="answers['${q.id}']=this.value" autocomplete="off"/>
      </div>`;
    });
    html += `</div></div>`;
  } else {
    sec.questions.forEach(q => {
      html += `<div class="q-card"><div class="q-label">${q.label}</div>`;
      if (q.sub) html += `<div class="q-sub">${q.sub}</div>`;
      if (q.type==='single') {
        q.options.forEach((opt,i) => {
          const sel = answers[q.id]===i?'selected':'';
          html += `<button class="option-btn ${sel}" onclick="selectOption('${q.id}',${i})">
            <span class="option-dot"><span class="option-dot-inner"></span></span>
            <span>${opt.text}</span>
          </button>`;
        });
      } else if (q.type==='open') {
        const val = (answers[q.id]||'').replace(/</g,'&lt;');
        html += `<textarea class="q-textarea" placeholder="${q.placeholder}" oninput="answers['${q.id}']=this.value">${val}</textarea>`;
      }
      html += `</div>`;
    });
  }

  const isLast = currentSection===sections.length-1;
  html += `<div class="nav-row">`;
  html += currentSection>0 ? `<button class="btn-back" onclick="goBack()">← Retour</button>` : `<span></span>`;
  html += `<span class="step-info">${currentSection+1} sur ${sections.length}</span>`;
  html += isLast
    ? `<button class="btn-next" id="submitBtn" onclick="submitForm()">Soumettre →</button>`
    : `<button class="btn-next" onclick="goNext()">Suivant →</button>`;
  html += `</div>`;

  root.innerHTML = html;
  window.scrollTo({top:0,behavior:'smooth'});
}

function selectOption(qid,idx) { answers[qid]=idx; render(); }
function goBack() { if(currentSection>0){currentSection--;render();} }

function goNext() {
  const sec = sections[currentSection];
  if (sec.id==='contact') {
    if (sec.questions.some(q=>!answers[q.id]||answers[q.id].trim()==='')) {
      alert('Veuillez remplir tous les champs avant de continuer.'); return;
    }
  } else {
    if (sec.questions.some(q=>q.type==='single'&&answers[q.id]===undefined)) {
      alert('Veuillez répondre à toutes les questions avant de continuer.'); return;
    }
  }
  currentSection++; render();
}

function submitForm() {
  if (sections[currentSection].questions.some(q=>q.type==='single'&&answers[q.id]===undefined)) {
    alert('Veuillez répondre à toutes les questions avant de soumettre.'); return;
  }
  if (sending) return;
  sending = true;
  const btn = document.getElementById('submitBtn');
  if (btn) { btn.disabled=true; btn.innerHTML='<span class="spin">↻</span> Envoi…'; }
  emailjs.init(EMAILJS_PUBLIC_KEY);
  emailjs.send(EMAILJS_SERVICE_ID,EMAILJS_TEMPLATE_ID,{
    to_email:'legroupecmp@gmail.com',
    from_name:answers['name']||'Candidat',
    reply_to:answers['email']||'',
    phone:answers['phone']||'',
    message:buildEmailBody(),
  }).then(()=>{currentSection=sections.length;render();})
    .catch(err=>{console.error('EmailJS:',err);currentSection=sections.length;render();});
}

function renderResult(root) {
  const name = (answers['name']||'Candidat(e)').split(' ')[0];
  root.innerHTML = `
    <div class="result-card">
      <div class="result-icon">✓</div>
      <h2 class="result-title">Merci, ${name}&nbsp;!</h2>
      <p class="result-sub">Votre questionnaire a bien été soumis. Nous prendrons le temps de l'analyser et vous contacterons dans les <strong>48 à 72 heures</strong> pour les prochaines étapes.</p>
      <div class="result-notice">✉ Confirmation envoyée à ${answers['email']||'votre courriel'}</div>
    </div>`;
  window.scrollTo({top:0,behavior:'smooth'});
}

emailjs.init(EMAILJS_PUBLIC_KEY);
render();
</script>
</body>
</html>
